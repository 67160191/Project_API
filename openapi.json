        "summary": "ลบงานออกจากระบบ (Delete Task)",
        "description": "ลบงานตาม Task ID ที่ระบุ (ป้ายกำกับที่ผูกไว้จะถูกลบความสัมพันธ์โดยอัตโนมัติ)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "รหัสประจำงาน (Task ID)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ลบงานออกจากระบบสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "ลบงานรหัส 1 เรียบร้อยแล้ว"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
