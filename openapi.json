{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Management System API",
    "description": "# เอกสาร API ระบบจัดการงาน (Task Management System)\nโครงงานระยะที่ 2: เอกสาร API และการเชื่อมต่อภายนอก (Docs/DX & External Integration)\n\n### ฟีเจอร์หลักในระบบ:\n1. **Tasks Resource**: จัดการงาน เพิ่ม อ่าน แก้ไข ลบ เปลี่ยนสถานะ (CRUD)\n2. **Users & Tags Resources**: จัดการข้อมูลผู้ใช้และหมวดหมู่ป้ายกำกับ\n3. **External API Integration & Resilience (สัปดาห์ที่ 11)**: เชื่อมต่อบริการสภาพอากาศภายนอก (Open-Meteo API) พร้อมกลไกความทนทาน:\n   - **Retry Logic**: เรียกซ้ำอัตโนมัติ 2 ครั้งพร้อม Exponential Backoff\n   - **Timeout**: ตัดการรอเมื่อเกิน 3,000 ms ด้วย AbortController\n   - **Graceful Fallback**: ส่งมอบข้อมูลสำรองพร้อมคำแนะนำเมื่อภายนอกล้มเหลว\n",
    "version": "2.0.0",
    "contact": {
      "name": "ผู้พัฒนาโครงงาน (รหัสนิสิต 67160191)",
      "email": "67160191@go.buu.ac.th"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "การจัดการข้อมูลงาน (CRUD & Status)"
    },
    {
      "name": "External Integration (Weather)",
      "description": "การเชื่อมต่อบริการภายนอกพร้อมกลไกความทนทาน (Retry, Timeout, Fallback)"
    },
    {
      "name": "Users",
      "description": "การจัดการข้อมูลผู้ใช้งาน"
    },
    {
      "name": "Tags",
      "description": "การจัดการหมวดหมู่และป้ายกำกับ"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "ดึงรายการงานทั้งหมด (List Tasks)",
        "description": "เรียกดูรายการงานทั้งหมดในระบบ สามารถกรองตามสถานะงาน (status) หรือรหัสผู้ใช้ (user_id) ได้",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "กรองตามสถานะงาน",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ],
              "example": "in_progress"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "description": "กรองตามรหัสผู้ใช้งาน (user_id)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ดึงข้อมูลรายการงานสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "total": {
                      "type": "integer",
                      "example": 3
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "สร้างงานใหม่ (Create Task)",
        "description": "บันทึกงานใหม่เข้าสู่ระบบ พร้อมทั้งสามารถระบุป้ายกำกับ (tags) ได้ในคราวเดียว",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              },
              "example": {
                "title": "ส่งรายงานความคืบหน้าโครงงานระยะที่ 2",
                "description": "จัดทำเอกสาร OpenAPI, Swagger UI และเขียนโค้ด Resilience ให้เสร็จสมบูรณ์",
                "due_date": "2026-08-30",
                "status": "pending",
                "user_id": 1,
                "tag_ids": [
                  1,
                  3
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "สร้างงานใหม่สำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "สร้างงานใหม่สำเร็จ"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Task"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "description": "ไม่พบ user_id ที่ระบุ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "USER_NOT_FOUND",
                    "message": "ไม่พบผู้ใช้งาน user_id: 99 ในระบบ"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/tasks/{id}": {
