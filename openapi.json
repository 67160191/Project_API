      }
    },
    "/api/v1/tasks/{id}/status": {
      "patch": {
        "tags": [
          "Tasks"
        ],
        "summary": "อัปเดตเฉพาะสถานะของงาน (Update Task Status)",
        "description": "เปลี่ยนสถานะงาน เช่น จาก pending เป็น completed",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "รหัสประจำงาน (Task ID)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
