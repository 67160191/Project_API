    "/api/v1/tasks/{id}/weather": {
      "get": {
        "tags": [
          "External Integration (Weather)"
        ],
        "summary": "ตรวจสอบสภาพอากาศสำหรับงาน (External API Integration with Resilience)",
        "description": "เรียกใช้บริการภายนอก Open-Meteo Weather API เพื่อตรวจสอบสภาพอากาศสำหรับวางแผนการทำงาน\n\n**กลไกความทนทานต่อความผิดพลาด (Resilience Mechanisms):**\n- **Timeout (3,000ms):** ตัดการเชื่อมต่อเมื่อรอนานเกินเวลา\n- **Retry Logic (2 retries / 3 attempts):** เรียกซ้ำอัตโนมัติพร้อม Exponential Backoff (500ms, 1000ms) เมื่อเกิด Network Error หรือรหัส 5xx\n- **Graceful Fallback:** คืนค่าข้อมูลสำรองที่ปลอดภัย ไม่ทำให้ระบบหยุดทำงาน (isFallback = true)\n\n**การจำลอง Failure Scenario เพื่อทดสอบ:**\n- `mockFailure=network` : จำลอง Unreachable Network / DNS Error\n- `mockFailure=timeout` : จำลอง Server ช้ากว่า Timeout (ค้างเกิน 3000ms)\n- `mockFailure=500`     : จำลอง External Server ส่งกลับ 500\n",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "รหัสประจำงาน (Task ID)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "mockFailure",
            "in": "query",
            "required": false,
            "description": "ใช้สำหรับจำลองสถานการณ์ความผิดพลาดเพื่อทดสอบ Resilience",
            "schema": {
              "type": "string",
              "enum": [
                "network",
                "timeout",
                "500"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ได้รับข้อมูลสภาพอากาศ (อาจเป็นข้อมูลจริง หรือข้อมูล Fallback กรณีบริการภายนอกล้มเหลว)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/weather": {
      "get": {
        "tags": [
          "External Integration (Weather)"
        ],
        "summary": "ทดสอบดึงข้อมูลสภาพอากาศและจำลอง Failure Scenarios โดยตรง",
        "description": "เรียกทดสอบ Weather Integration โดยตรง สามารถระบุพิกัด เมือง หรือโหมดจำลองความผิดพลาดได้",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "ชื่อเมือง (เช่น Bangkok, Chonburi)",
            "schema": {
              "type": "string",
              "example": "Bangkok"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "ละติจูด",
            "schema": {
              "type": "number",
              "example": 13.75
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "ลองจิจูด",
            "schema": {
              "type": "number",
              "example": 100.51
            }
          },
          {
            "name": "mockFailure",
            "in": "query",
            "required": false,
            "description": "โหมดจำลองความผิดพลาดเพื่อทดสอบ Retry, Timeout และ Fallback",
            "schema": {
              "type": "string",
              "enum": [
                "network",
                "timeout",
                "500"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ผลลัพธ์การเรียก Weather API หรือผลการ Fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
