{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Management System API",
    "description": "# เอกสาร API ระบบจัดการงาน (Task Management System)\nโครงงานระยะที่ 3: นำเสนอโครงงาน (Final Integration & Project Defense)\n\n### สถาปัตยกรรมและฟีเจอร์ในระบบ:\n1. **Tasks Resource (Phase 1):** จัดการงาน เพิ่ม อ่าน แก้ไข ลบ เปลี่ยนสถานะ (CRUD)\n2. **Users & Tags Resources (Phase 1):** จัดการข้อมูลผู้ใช้และหมวดหมู่ป้ายกำกับ\n3. **External API Resilience Integration (Phase 2):** เชื่อมต่อบริการสภาพอากาศภายนอก (Open-Meteo API) พร้อม Timeout, Retry (Exponential Backoff), และ Graceful Fallback\n4. **Microservices Integration (Phase 3 / Week 13):**\n   - **Analytics Microservice:** คำนวณสรุปสถิติงาน อัตราสำเร็จ และการกระจายงาน\n   - **Notification Microservice:** จัดการการส่งแจ้งเตือนงานผ่าน Email/SMS/Webhook และบันทึก Dispatch Logs\n5. **Client-Facing Frontend (Phase 3 / CLO6):** ส่วนติดต่อผู้ใช้ Interactive Web Application ที่เข้าถึงได้ที่ `/app`\n",
    "version": "3.0.0",
    "contact": {
      "name": "ผู้พัฒนาโครงงาน (รหัสนิสิต 67160191)",
      "email": "67160191@go.buu.ac.th"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Unified Server"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "การจัดการข้อมูลงาน (CRUD & Status)"
    },
    {
      "name": "External Integration (Weather)",
      "description": "การเชื่อมต่อบริการภายนอกพร้อมกลไกความทนทาน (Retry, Timeout, Fallback)"
    },
    {
      "name": "Microservices",
      "description": "โมดูล Microservices จากสัปดาห์ที่ 13 (Analytics & Notifications)"
    },
    {
      "name": "Users",
      "description": "การจัดการข้อมูลผู้ใช้งาน"
    },
    {
      "name": "Tags",
      "description": "การจัดการหมวดหมู่และป้ายกำกับ"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "ดึงรายการงานทั้งหมด (List Tasks)",
        "description": "เรียกดูรายการงานทั้งหมดในระบบ สามารถกรองตามสถานะงาน (status) หรือรหัสผู้ใช้ (user_id) ได้",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "กรองตามสถานะงาน",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ],
              "example": "in_progress"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "description": "กรองตามรหัสผู้ใช้งาน (user_id)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ดึงข้อมูลรายการงานสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "total": {
                      "type": "integer",
                      "example": 3
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "สร้างงานใหม่ (Create Task)",
        "description": "บันทึกงานใหม่เข้าสู่ระบบ พร้อมทั้งสามารถระบุป้ายกำกับ (tags) ได้ในคราวเดียว",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              },
              "example": {
                "title": "ส่งรายงานความคืบหน้าโครงงานระยะที่ 3",
                "description": "รวมโมดูลทั้งหมด ทำ Frontend และเตรียมนำเสนอ Project Defense",
                "due_date": "2026-08-30",
                "status": "pending",
                "user_id": 1,
                "tag_ids": [
                  1,
                  3
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "สร้างงานใหม่สำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "สร้างงานใหม่สำเร็จ"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Task"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "description": "ไม่พบ user_id ที่ระบุ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "ดึงรายละเอียดงานตาม ID (Get Task by ID)",
        "description": "ดึงข้อมูลงาน 1 รายการโดยละเอียด รวมถึงชื่อผู้รับผิดชอบ (owner) และรายการป้ายกำกับ (tags)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "รหัสประจำงาน (Task ID)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "พบข้อมูลงานที่ระบุ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/TaskDetail"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Tasks"
        ],
        "summary": "แก้ไขข้อมูลงานทั้งหมด (Update Task)",
        "description": "ปรับปรุงข้อมูลงานที่มีอยู่เดิมตาม ID ที่ระบุ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "รหัสประจำงาน (Task ID)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "แก้ไขข้อมูลงานสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "แก้ไขข้อมูลงานสำเร็จ"
                    },
                    "data": {
                      "$ref": "#/components/schemas/TaskDetail"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Tasks"
        ],
        "summary": "ลบงานออกจากระบบ (Delete Task)",
        "description": "ลบงานตาม Task ID ที่ระบุ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "รหัสประจำงาน (Task ID)",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ลบงานออกจากระบบสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "ลบงานรหัส 1 เรียบร้อยแล้ว"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
