    "/api/v1/tasks/{id}/weather": {
      "get": {
        "tags": [
          "External Integration (Weather)"
        ],
        "summary": "ตรวจสอบสภาพอากาศสำหรับงาน (External API with Resilience)",
        "description": "เรียกใช้ Open-Meteo Weather API พร้อม Timeout (3s), Retry 2 ครั้ง (Exponential Backoff), และ Graceful Fallback",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "mockFailure",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "network",
                "timeout",
                "500"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ผลลัพธ์สภาพอากาศจริงหรือข้อมูล Fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/v1/weather": {
      "get": {
        "tags": [
          "External Integration (Weather)"
        ],
        "summary": "ทดสอบดึงข้อมูลสภาพอากาศและจำลอง Failure Scenarios โดยตรง",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "Bangkok"
            }
          },
          {
            "name": "mockFailure",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "network",
                "timeout",
                "500"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ผลลัพธ์สภาพอากาศ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "tags": [
          "Microservices"
        ],
        "summary": "ดึงข้อมูลสรุปสถิติงาน (Task Analytics Microservice)",
        "description": "โมดูล Microservice จากสัปดาห์ที่ 13 ประมวลผลและคำนวณอัตราความสำเร็จ (Completion Rate), จำนวนงานที่เสร็จ, งานที่ค้าง และประสิทธิภาพรวม",
        "responses": {
          "200": {
            "description": "สรุปสถิติภาพรวมสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "totalTasks": {
                          "type": "integer",
                          "example": 4
                        },
                        "completedTasks": {
                          "type": "integer",
                          "example": 1
                        },
                        "pendingTasks": {
                          "type": "integer",
                          "example": 2
                        },
                        "inProgressTasks": {
                          "type": "integer",
                          "example": 1
                        },
                        "completionRatePercent": {
                          "type": "integer",
                          "example": 25
                        }
                      }
                    },
                    "performanceScore": {
                      "type": "string",
                      "example": "Needs Attention"
                    },
                    "microserviceVersion": {
                      "type": "string",
                      "example": "1.2.0"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/send": {
      "post": {
        "tags": [
          "Microservices"
        ],
        "summary": "ส่งการแจ้งเตือนงาน (Notification Microservice)",
        "description": "โมดูล Microservice สำหรับส่งการแจ้งเตือนงานผ่าน Email, SMS หรือ Webhook พร้อมจัดเก็บบันทึกประวัติการส่ง",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "taskId",
                  "recipient",
                  "message"
                ],
                "properties": {
                  "taskId": {
                    "type": "integer",
                    "example": 1
                  },
                  "recipient": {
                    "type": "string",
                    "example": "somchai@example.com"
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "email",
                      "sms",
                      "webhook"
                    ],
                    "default": "email",
                    "example": "email"
                  },
                  "subject": {
                    "type": "string",
                    "example": "แจ้งเตือนงานใกล้ครบกำหนด"
                  },
                  "message": {
                    "type": "string",
                    "example": "กรุณาส่งรายงานภายในวันพรุ่งนี้"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "high",
                      "urgent"
                    ],
                    "default": "normal",
                    "example": "high"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ส่งการแจ้งเตือนสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "ส่งการแจ้งเตือนผ่าน Notification Microservice สำเร็จ"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          }
        }
      }
    },
